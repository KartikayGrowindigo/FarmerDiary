                        "tertiary-fixed-dim": "#c8c6c3",
                        "outline": "#6f7978",
                        "surface-bright": "#fcf9f8",
                        "surface-tint": "#166965",
                        "on-error-container": "#93000a",
                        "on-secondary": "#ffffff",
