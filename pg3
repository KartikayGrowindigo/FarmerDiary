<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;700&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400; }
        .material-symbols-outlined.filled { font-variation-settings: 'FILL' 1; }
        
        /* Hide scrollbar for horizontal scrolling containers */
        .hide-scrollbar::-webkit-scrollbar { display: none; }
        .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
<style>
    body {
      min-height: max(884px, 100dvh);
    }
  </style>
  </head>
<body class="bg-surface text-on-surface min-h-screen flex flex-col relative pb-32">
<!-- Header -->
<header class="bg-surface dark:bg-surface-dim shadow-sm docked full-width top-0 z-10 sticky top-0">
<div class="flex flex-col justify-center w-full px-margin-edge py-stack-md">
<div class="flex items-center gap-4">
<button class="h-touch-target-min w-touch-target-min flex items-center justify-center -ml-2 text-primary active:scale-95 transition-transform">
<span class="material-symbols-outlined text-[28px]">arrow_back</span>
</button>
<div>
<h1 class="text-headline-sm font-headline-sm text-primary">Add Fertilizer</h1>
<p class="text-punjabi-subtext font-punjabi-subtext text-on-surface-variant">ਖਾਦ ਸ਼ਾਮਲ ਕਰੋ</p>
</div>
</div>
</div>
</header>
<main class="flex-1 px-margin-edge py-stack-lg space-y-stack-lg">
<!-- Date Picker -->
<section>
<div class="bg-surface-container-lowest rounded-xl shadow-soft-elevation p-5 border-2 border-transparent focus-within:border-primary transition-colors">
<label class="flex justify-between items-end mb-2">
<div>
<span class="block text-body-md font-body-md text-on-surface">Date of Application</span>
<span class="block text-punjabi-subtext font-punjabi-subtext text-on-surface-variant">ਅਰਜ਼ੀ ਦੀ ਮਿਤੀ</span>
</div>
</label>
<div class="relative">
<input class="w-full h-touch-target-min bg-surface-container-low border-2 border-outline-variant rounded-lg px-4 text-body-lg font-body-lg focus:border-primary focus:ring-0 outline-none text-on-surface appearance-none" type="date" value="2023-10-24"/>
<div class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-primary">
<span class="material-symbols-outlined">calendar_month</span>
</div>
</div>
</div>
</section>
<!-- Product Section (Horizontal Chips) -->
<section>
<div class="mb-stack-sm flex justify-between items-end">
<h2 class="text-headline-sm font-headline-sm text-on-surface">Product</h2>
<span class="text-punjabi-subtext font-punjabi-subtext text-on-surface-variant">ਉਤਪਾਦ</span>
</div>
<div class="flex gap-3 overflow-x-auto hide-scrollbar pb-2 -mx-margin-edge px-margin-edge snap-x">
<!-- DAP (Active) -->
<button class="snap-start flex-shrink-0 h-touch-target-min px-6 rounded-xl border-2 border-primary bg-primary text-on-primary flex flex-col justify-center items-center active:scale-95 transition-transform shadow-soft-elevation">
<span class="text-body-lg font-body-lg font-bold">DAP</span>
</button>
<!-- Urea -->
<button class="snap-start flex-shrink-0 h-touch-target-min px-6 rounded-xl border-2 border-outline-variant bg-surface-container-lowest text-on-surface-variant flex flex-col justify-center items-center active:scale-95 transition-transform">
<span class="text-body-lg font-body-lg">Urea</span>
</button>
<!-- MOP -->
<button class="snap-start flex-shrink-0 h-touch-target-min px-6 rounded-xl border-2 border-outline-variant bg-surface-container-lowest text-on-surface-variant flex flex-col justify-center items-center active:scale-95 transition-transform">
<span class="text-body-lg font-body-lg">MOP</span>
</button>
<!-- Zinc -->
<button class="snap-start flex-shrink-0 h-touch-target-min px-6 rounded-xl border-2 border-outline-variant bg-surface-container-lowest text-on-surface-variant flex flex-col justify-center items-center active:scale-95 transition-transform">
<span class="text-body-lg font-body-lg">Zinc</span>
</button>
<!-- Bio -->
<button class="snap-start flex-shrink-0 h-touch-target-min px-6 rounded-xl border-2 border-outline-variant bg-surface-container-lowest text-on-surface-variant flex flex-col justify-center items-center active:scale-95 transition-transform">
<span class="text-body-lg font-body-lg">Bio</span>
</button>
</div>
</section>
<!-- Quantity Section -->
<section class="bg-surface-container-lowest rounded-xl shadow-soft-elevation p-6">
<div class="text-center mb-6">
<h2 class="text-headline-sm font-headline-sm text-on-surface">Quantity (kg/acre)</h2>
<p class="text-punjabi-subtext font-punjabi-subtext text-on-surface-variant">ਮਾਤਰਾ (ਕਿਲੋ/ਏਕੜ)</p>
</div>
<div class="flex items-center justify-between bg-surface-container-low rounded-xl p-2 border-2 border-outline-variant">
<button class="w-16 h-16 rounded-lg bg-surface-container-lowest border border-outline-variant flex items-center justify-center text-primary active:scale-95 transition-transform shadow-sm">
<span class="material-symbols-outlined text-[32px] font-bold">remove</span>
</button>
<div class="text-center w-24">
<span class="text-[40px] font-bold leading-none text-primary-container">50</span>
</div>
<button class="w-16 h-16 rounded-lg bg-primary text-on-primary flex items-center justify-center active:scale-95 transition-transform shadow-sm">
<span class="material-symbols-outlined text-[32px] font-bold">add</span>
</button>
</div>
</section>
<!-- Method Section -->
<section>
<div class="mb-stack-sm flex justify-between items-end">
<h2 class="text-headline-sm font-headline-sm text-on-surface">Method</h2>
<span class="text-punjabi-subtext font-punjabi-subtext text-on-surface-variant">ਢੰਗ</span>
</div>
<div class="grid grid-cols-2 gap-4">
<!-- Broadcasting (Active) -->
<button class="h-24 bg-primary-container/10 border-2 border-primary rounded-xl p-4 flex flex-col items-center justify-center gap-2 active:scale-95 transition-transform relative overflow-hidden">
<div class="absolute inset-0 bg-primary opacity-5"></div>
<span class="material-symbols-outlined filled text-primary text-[28px]">scatter_plot</span>
<span class="text-body-md font-body-md font-bold text-primary">Broadcast</span>
</button>
<!-- With Seeder -->
<button class="h-24 bg-surface-container-lowest shadow-soft-elevation border-2 border-transparent rounded-xl p-4 flex flex-col items-center justify-center gap-2 active:scale-95 transition-transform text-on-surface-variant">
<span class="material-symbols-outlined text-[28px]">agriculture</span>
<span class="text-body-md font-body-md">Seeder</span>
</button>
<!-- Fertigation -->
<button class="h-24 bg-surface-container-lowest shadow-soft-elevation border-2 border-transparent rounded-xl p-4 flex flex-col items-center justify-center gap-2 active:scale-95 transition-transform text-on-surface-variant">
<span class="material-symbols-outlined text-[28px]">water_drop</span>
<span class="text-body-md font-body-md">Fertigation</span>
</button>
<!-- Spray -->
<button class="h-24 bg-surface-container-lowest shadow-soft-elevation border-2 border-transparent rounded-xl p-4 flex flex-col items-center justify-center gap-2 active:scale-95 transition-transform text-on-surface-variant">
<span class="material-symbols-outlined text-[28px]">cloud_download</span>
<span class="text-body-md font-body-md">Spray</span>
</button>
<!-- Drenching -->
<button class="h-24 bg-surface-container-lowest shadow-soft-elevation border-2 border-transparent rounded-xl p-4 flex flex-col items-center justify-center gap-2 active:scale-95 transition-transform text-on-surface-variant col-span-2">
<span class="material-symbols-outlined text-[28px]">opacity</span>
<span class="text-body-md font-body-md">Drenching</span>
</button>
</div>
</section>
<!-- Apply to all plots toggle -->
<section class="bg-surface-container-lowest rounded-xl shadow-soft-elevation p-5 flex items-center justify-between">
<div>
<span class="block text-body-lg font-body-lg text-on-surface font-bold">Apply to all 4 plots</span>
<span class="block text-punjabi-subtext font-punjabi-subtext text-on-surface-variant mt-1">ਸਾਰੇ 4 ਪਲਾਟਾਂ 'ਤੇ ਲਾਗੂ ਕਰੋ</span>
</div>
<!-- Custom Toggle -->
<button aria-pressed="false" class="w-14 h-8 rounded-full bg-surface-variant relative p-1 flex items-center transition-colors aria-pressed:bg-primary group" onclick="this.setAttribute('aria-pressed', this.getAttribute('aria-pressed') === 'true' ? 'false' : 'true'); this.querySelector('div').classList.toggle('translate-x-6'); this.querySelector('div').classList.toggle('bg-on-surface-variant'); this.querySelector('div').classList.toggle('bg-on-primary');">
<div class="w-6 h-6 rounded-full bg-on-surface-variant shadow-md transform transition-transform duration-200 ease-in-out"></div>
</button>
</section>
</main>
<!-- Fixed Bottom Action -->
<div class="fixed bottom-0 left-0 right-0 p-margin-edge bg-surface/90 backdrop-blur-md z-20 border-t border-surface-variant">
<button class="w-full h-touch-target-min bg-primary text-on-primary rounded-xl text-headline-sm font-headline-sm flex items-center justify-center gap-3 active:scale-98 transition-transform shadow-lg">
<span class="material-symbols-outlined">save</span>
            Save Entry
        </button>
</div>
</body></html>