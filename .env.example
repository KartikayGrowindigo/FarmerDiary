# Supabase project (Project Settings -> API). Both values are public; the database's
# row-level security decides what each signed-in account can see.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=
# Set to true once the Azure (Microsoft) provider is enabled in Supabase to show "Sign in with Microsoft".
VITE_AUTH_MICROSOFT=false
